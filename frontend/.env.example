# Copy this file to .env.local and fill in real values. Never commit the real .env.local.

# Appwrite project used for auth + chat history (src/utils/appwrite/client.ts).
# NEXT_PUBLIC_* values are exposed to the browser by design -- they identify
# the project, they are not secrets. Data access is governed by Appwrite's
# per-row permissions (see Backend/scripts/setup_appwrite.py) plus the
# signed-in user's own session.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=nucleus

# Base URL of the Nucleus backend API (see ../Backend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
