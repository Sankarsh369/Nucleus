# Copy this file to .env and fill in real values. Never commit the real .env.

# LLM providers used for QA validation (app/llm_client.py tries them in order:
# Gemini -> Groq -> Claude -> local mock fallback). All are optional; the app
# degrades gracefully to a mock answerer if none are configured.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown in app/config.py)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Appwrite persistence for cache/metrics/sessions/traces (app/database.py).
# Create a project at https://cloud.appwrite.io, then Project Settings ->
# API Keys -> create a server key with the "databases.write"/"databases.read"
# scopes. Treat APPWRITE_API_KEY like a database admin password: it bypasses
# all row/document permissions, so never expose it to the frontend or commit
# it to version control.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=nucleus

# After filling in the three values above, run this once to create the
# database/tables/columns Nucleus needs:
#   python scripts/setup_appwrite.py

# Optional: require an X-API-Key header on /compress endpoints. Leave blank to
# disable auth (fine for local dev, not recommended for a public deployment).
NUCLEUS_API_KEY=

# Optional: set to "true" on memory-constrained hosts (e.g. Render's free
# 512MB web service tier) to skip loading torch/sentence-transformers
# entirely at startup. Without this, the real embedding model can get the
# process OOM-killed before it ever binds a port. The app still works fully
# in this mode -- Stage 2 semantic dedup falls back to a bag-of-words
# heuristic (see get_model() in app/compressor.py).
NUCLEUS_FORCE_MOCK_EMBEDDINGS=
